---
import "../styles/fonts.css";
import "../styles/global.css";
import type { Locale } from "../data/site";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  alternatePath?: string;
  structuredData?: boolean;
  noindex?: boolean;
}

const { locale, title, description, alternatePath, structuredData = false, noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const alternateUrl = alternatePath ? new URL(alternatePath, Astro.site) : undefined;
const englishUrl = locale === "en" ? canonicalUrl : alternateUrl;
const germanUrl = locale === "de" ? canonicalUrl : alternateUrl;
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Anna Spiechowicz",
  url: "https://annaspiechowicz.com",
  jobTitle: ["Product Owner", "Business Analyst"],
  email: "mailto:anna.maria.spiechowicz@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressRegion: "Hesse",
    addressCountry: "DE"
  },
  alumniOf: [
    {
      "@type": "CollegeOrUniversity",
      name: "AGH University of Science and Technology"
    },
    {
      "@type": "CollegeOrUniversity",
      name: "The Silesian University of Technology"
    }
  ],
  knowsLanguage: ["Polish", "English", "German", "French"],
  sameAs: ["https://www.linkedin.com/in/anna-spiechowicz-166b25108/"]
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalUrl} />
    {englishUrl && <link rel="alternate" hreflang="en" href={englishUrl} />}
    {germanUrl && <link rel="alternate" hreflang="de" href={germanUrl} />}
    {englishUrl && <link rel="alternate" hreflang="x-default" href={englishUrl} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://annaspiechowicz.com/og-image.png" />
    <meta property="og:image:alt" content="Anna Spiechowicz, Product Owner and Business Analyst" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === "de" ? "de_DE" : "en_GB"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://annaspiechowicz.com/og-image.png" />
    <meta name="twitter:image:alt" content="Anna Spiechowicz, Product Owner and Business Analyst" />
    <title>{title}</title>
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />}
    <script is:inline>
      document.documentElement.classList.add("js");
      /* Light is the default, so only a stored dark choice needs applying - and
         it has to land before first paint or the page flashes light first. */
      try {
        if (localStorage.getItem("theme") === "dark") {
          document.documentElement.setAttribute("data-theme", "dark");
          var m = document.createElement("meta");
          m.name = "theme-color";
          m.id = "theme-color-choice";
          m.content = "#0b1017";
          document.head.appendChild(m);
        }
      } catch (e) {
        /* storage blocked: the page stays light, which is the default */
      }
    </script>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <slot />
  </body>
</html>
