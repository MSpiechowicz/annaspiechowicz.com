---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  locale="de"
  title="Impressum | Anna Spiechowicz"
  description="Anbieterkennzeichnung und Kontaktangaben für annaspiechowicz.com."
>
  <main class="legal-page">
    <header class="legal-header shell">
      <a class="brand-mark" href="/de/">
        <b aria-hidden="true">AS</b>
        Anna Spiechowicz
      </a>
      <a class="legal-back" href="/de/">Zur Startseite</a>
    </header>

    <article class="legal-content shell">
      <header class="legal-hero">
        <p class="label">Rechtliche Angaben</p>
        <h1>Impressum</h1>
      </header>

      <section>
        <h2>Angaben gemäß § 5 DDG</h2>
        <address>
          Anna Spiechowicz<br />
          Alte Weinstraße 11<br />
          35510 Butzbach<br />
          Deutschland
        </address>
      </section>

      <section>
        <h2>Kontakt</h2>
        <p>
          E-Mail: <a href="mailto:anna.maria.spiechowicz@gmail.com">anna.maria.spiechowicz@gmail.com</a>
        </p>
      </section>

      <section>
        <h2>Verantwortlich für den Inhalt</h2>
        <p>Anna Spiechowicz, Anschrift wie oben.</p>
      </section>

      <p class="legal-date">Stand: 3. September 2026</p>
    </article>
  </main>
</BaseLayout>
